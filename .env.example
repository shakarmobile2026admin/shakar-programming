# تنظیمات پایگاه‌داده
DATABASE_URL=postgresql://user:password@localhost:5432/shakar_db
DATABASE_DEBUG=False

# تنظیمات سیستم
APP_NAME=نرم‌افزار حسابداری شاکر
APP_VERSION=1.0.0
DEBUG=False

# تنظیمات امنیتی
SECRET_KEY=your-secret-key-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here

# تنظیمات درگاه پرداخت
PAYMENT_GATEWAY_URL=https://api.payment-gateway.com
PAYMENT_GATEWAY_KEY=your-api-key
PAYMENT_GATEWAY_SECRET=your-api-secret

# تنظیمات کارتخوان
CARD_READER_PORT=/dev/ttyUSB0
CARD_READER_BAUDRATE=9600

# تنظیمات سایت
WEBSITE_API_URL=https://api.website.com
WEBSITE_API_KEY=your-website-api-key

# تنظیمات نسخه‌پشتی
BACKUP_PATH=/backups/shakar/
BACKUP_INTERVAL=24
BACKUP_RETENTION_DAYS=30

# تنظیمات لاگ
LOG_LEVEL=INFO
LOG_PATH=/logs/shakar/

# تنظیمات گاه‌شماری
CALENDAR_TYPE=jalali

# تنظیمات مالیات
TAX_RATE=0.09
VAT_RATE=0.00